# MongoDB Configuration (cho production)
# Nếu không có MongoDB, hệ thống sẽ tự động fallback sang SQLite
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/transport_data_db
DATABASE_NAME=transport_data_db

# Admin Account (cho production)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password_here

# SQLite fallback path (chỉ dùng khi MongoDB không khả dụng)
# SQLITE_DB_PATH=./transport_data.db
